<mxfile host="drawio"><diagram name="../img/alur_algoritma" id="../img/alur_algoritma"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1080" pageHeight="1480" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Paket telemetri tag&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;(±3–5 paket/detik)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;rounded=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="210" y="10" width="260" height="60" as="geometry"/></mxCell><mxCell id="c2" value="A" style="ellipse;html=1;fontFamily=Arial;fontSize=16;fontStyle=1;fillColor=#ffffff;strokeColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="40" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Ambil sampel jarak&lt;br&gt;berikutnya" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="100" width="260" height="60" as="geometry"/></mxCell><mxCell id="c4" value="Sampel baru &amp;amp;&lt;br&gt;jarak masuk akal?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="200" y="190" width="280" height="110" as="geometry"/></mxCell><mxCell id="c5" value="Abaikan&lt;br&gt;sampel" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="10" y="215" width="140" height="60" as="geometry"/></mxCell><mxCell id="c6" value="A" style="ellipse;html=1;fontFamily=Arial;fontSize=16;fontStyle=1;fillColor=#ffffff;strokeColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="40" height="40" as="geometry"/></mxCell><mxCell id="c7" value="Waktu device → server" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="330" width="260" height="64" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Koreksi kalibrasi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;jarak − offset anchor dari kalibrasi&lt;br&gt;statis; belum dikalibrasi → offset&lt;br&gt;dipelajari EKF&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="425" width="260" height="92" as="geometry"/></mxCell><mxCell id="c9" value="Track tag&lt;br&gt;sudah ada?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="200" y="545" width="280" height="110" as="geometry"/></mxCell><mxCell id="c10" value="Inisialisasi&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;median sampel 0,7 s tiap anchor&lt;br&gt;→ multilaterasi; tanpa kalibrasi,&lt;br&gt;offset jarak b ikut dicari&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="10" y="690" width="270" height="100" as="geometry"/></mxCell><mxCell id="c11" value="A" style="ellipse;html=1;fontFamily=Arial;fontSize=16;fontStyle=1;fillColor=#ffffff;strokeColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="125" y="822" width="40" height="40" as="geometry"/></mxCell><mxCell id="c12" value="Prediksi EKF ke waktu sampel&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;mode diam: kecepatan = 0&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="580" y="10" width="240" height="64" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;State EKF&lt;/b&gt;: x, y, vx, vy&lt;br&gt;(+ offset jarak b dan offset&lt;br&gt;tiap anchor d₁…d₄ bila belum&lt;br&gt;dikalibrasi)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;" vertex="1" parent="1"><mxGeometry x="830" y="6" width="245" height="80" as="geometry"/></mxCell><mxCell id="c14" value="Hitung residu ternormalisasi&lt;br&gt;e = (z − h(x)) / √S" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="580" y="100" width="240" height="64" as="geometry"/></mxCell><mxCell id="c15" value="|e| ≤ 6 ?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="570" y="190" width="260" height="110" as="geometry"/></mxCell><mxCell id="c16" value="Tolak sampel&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;1,5 s semua ditolak →&lt;br&gt;inisialisasi ulang&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="870" y="196" width="180" height="84" as="geometry"/></mxCell><mxCell id="c17" value="A" style="ellipse;html=1;fontFamily=Arial;fontSize=16;fontStyle=1;fillColor=#ffffff;strokeColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="940" y="290" width="40" height="40" as="geometry"/></mxCell><mxCell id="c18" value="Mode diam &amp;amp; e &amp;gt; 1 ?&lt;br&gt;(jarak kepanjangan)" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="330" width="280" height="115" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Buang&lt;/b&gt; sampel&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;badan menghalangi; hanya&lt;br&gt;bila ≥ 3 anchor lain ada&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="870" y="352" width="190" height="86" as="geometry"/></mxCell><mxCell id="c20" value="A" style="ellipse;html=1;fontFamily=Arial;fontSize=16;fontStyle=1;fillColor=#ffffff;strokeColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="940" y="462" width="40" height="40" as="geometry"/></mxCell><mxCell id="c21" value="Update EKF robust&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;bobot turun bila e &amp;gt; 1 atau e &amp;lt; −2,5&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="580" y="480" width="240" height="64" as="geometry"/></mxCell><mxCell id="c22" value="Perbarui &lt;b&gt;mode diam&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;masuk: v &amp;lt; 0,2 m/s selama 0,4 s&lt;br&gt;keluar: 3 dari 4 |e| &amp;gt; 1,5&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="580" y="572" width="240" height="84" as="geometry"/></mxCell><mxCell id="c23" value="Batasi posisi&lt;br&gt;dalam ruangan" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="580" y="684" width="240" height="56" as="geometry"/></mxCell><mxCell id="c24" value="Masih ada sampel&lt;br&gt;di paket ini?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="570" y="765" width="260" height="110" as="geometry"/></mxCell><mxCell id="c25" value="A" style="ellipse;html=1;fontFamily=Arial;fontSize=16;fontStyle=1;fillColor=#ffffff;strokeColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="940" y="800" width="40" height="40" as="geometry"/></mxCell><mxCell id="c26" value="≥ 3 anchor diterima&lt;br&gt;dalam 1,5 s &amp;amp; σ ≤ 0,5 m?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="905" width="280" height="120" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Tahan&lt;/b&gt; posisi valid&lt;br&gt;terakhir&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;valid = false&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="923" width="180" height="84" as="geometry"/></mxCell><mxCell id="c28" value="Haluskan jalur?&lt;br&gt;(centang di Setup)" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="570" y="1060" width="260" height="110" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Rata-rata&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;3 posisi terakhir&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290" y="1073" width="230" height="84" as="geometry"/></mxCell><mxCell id="c30" value="Pakai keluaran EKF&lt;br&gt;langsung" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="580" y="1200" width="240" height="64" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Kirim posisi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;x, y, σ, valid → navigasi &amp;amp; dashboard&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="580" y="1290" width="240" height="70" as="geometry"/></mxCell><mxCel