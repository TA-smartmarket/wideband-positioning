ve="1" as="geometry"/></mxCell><mxCell id="c59" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#4d4d4d;endArrow=block;endFill=1;fontColor=#B20000;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c60" value="Ya" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#4d4d4d;endArrow=block;endFill=1;fontColor=#2D7600;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c61" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#4d4d4d;endArrow=block;endFill=1;fontColor=#B20000;" edge="1" parent="1" source="c28" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#4d4d4d;endArrow=block;endFill=1;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#4d4d4d;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c29" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#4d4d4d;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c27" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;strokeCol